// Prisma Schema — WhatsApp SaaS Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         UserRole @default(MEMBER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  businessMembers BusinessMember[]
  @@map("users")
}

enum UserRole { SUPER_ADMIN MEMBER }

enum SubscriptionTier { FREE STANDARD PREMIUM PLATINUM }

model Subscription {
  id         String           @id @default(cuid())
  businessId String           @unique
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tier             SubscriptionTier @default(FREE)
  maxWaAccounts    Int              @default(1)
  maxTeamMembers   Int              @default(1)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("subscriptions")
}

model Business {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members       BusinessMember[]
  credentials   WaCredential[]
  subscription  Subscription?
  messages      Message[]
  webhookSubs   WebhookSubscription[]
  events        AccountEvent[]
  phoneNumbers  PhoneNumber[]
  conversations Conversation[]
  templates     MessageTemplate[]
  bulkJobs      BulkSendJob[]
  @@map("businesses")
}

model BusinessMember {
  id         String             @id @default(cuid())
  businessId String
  userId     String
  role       BusinessMemberRole @default(VIEWER)
  createdAt  DateTime           @default(now())
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  waAccountAccess WaAccountAccess[]
  @@unique([businessId, userId])
  @@map("business_members")
}

enum BusinessMemberRole { OWNER ADMIN VIEWER }

model WaCredential {
  id         String @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name              String   @default("My WhatsApp Account")
  appId             String
  appSecretEnc      String
  accessTokenEnc    String
  wabaId            String
  phoneNumberId     String
  webhookRegistered Boolean   @default(false)
  lastVerifiedAt    DateTime?
  tags              String[]  @default([])
  displayPhone      String?
  country           String?
  messagingTier     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  waAccountAccess WaAccountAccess[]
  conversations   Conversation[]
  templates       MessageTemplate[]
  bulkJobs        BulkSendJob[]
  @@index([businessId])
  @@map("wa_credentials")
}

model WaAccountAccess {
  id               String         @id @default(cuid())
  businessMemberId String
  waCredentialId   String
  createdAt        DateTime       @default(now())
  businessMember BusinessMember @relation(fields: [businessMemberId], references: [id], onDelete: Cascade)
  waCredential   WaCredential   @relation(fields: [waCredentialId], references: [id], onDelete: Cascade)
  @@unique([businessMemberId, waCredentialId])
  @@map("wa_account_access")
}

model PhoneNumber {
  id            String  @id @default(cuid())
  businessId    String
  phoneNumberId String  @unique
  displayPhone  String
  verifiedName  String?
  qualityRating String?
  status        String?
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages Message[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("phone_numbers")
}

model Conversation {
  id             String   @id @default(cuid())
  businessId     String
  waCredentialId String
  contactPhone   String
  contactName    String?
  lastMessageAt  DateTime @default(now())
  unreadCount    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  waCredential WaCredential @relation(fields: [waCredentialId], references: [id], onDelete: Cascade)
  messages     Message[]
  @@unique([waCredentialId, contactPhone])
  @@index([businessId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id          String           @id @default(cuid())
  businessId  String
  waMessageId String           @unique
  direction   MessageDirection
  status      MessageStatus    @default(RECEIVED)
  fromPhone   String
  toPhone     String
  type        MessageType      @default(TEXT)
  textBody    String?
  mediaId     String?
  mediaMimeType String?
  mediaUrl    String?
  mediaCaption  String?
  interactiveType    String?
  interactivePayload Json?
  rawPayload         Json?
  phoneNumberId  String?
  phoneNumber    PhoneNumber?  @relation(fields: [phoneNumberId], references: [id])
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  timestamp  DateTime
  createdAt  DateTime @default(now())
  @@index([businessId, timestamp(sort: Desc)])
  @@index([waMessageId])
  @@index([conversationId, timestamp(sort: Desc)])
  @@map("messages")
}

enum MessageDirection { INBOUND OUTBOUND }
enum MessageStatus    { RECEIVED SENT DELIVERED READ FAILED }
enum MessageType      { TEXT IMAGE VIDEO AUDIO DOCUMENT STICKER LOCATION CONTACTS INTERACTIVE BUTTON UNKNOWN }

model MessageTemplate {
  id             String   @id @default(cuid())
  businessId     String
  waCredentialId String
  metaTemplateId String
  name           String
  language       String   @default("en_US")
  category       String
  status         String   @default("PENDING")
  components     Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  waCredential WaCredential @relation(fields: [waCredentialId], references: [id], onDelete: Cascade)
  bulkJobs     BulkSendJob[]
  @@unique([waCredentialId, metaTemplateId])
  @@index([businessId])
  @@map("message_templates")
}

model BulkSendJob {
  id             String   @id @default(cuid())
  businessId     String
  waCredentialId String
  templateId     String?
  status         String   @default("PENDING")
  totalCount     Int      @default(0)
  sentCount      Int      @default(0)
  failedCount    Int      @default(0)
  recipients     Json
  errorLog       Json?
  createdAt      DateTime @default(now())
  completedAt    DateTime?
  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  waCredential WaCredential     @relation(fields: [waCredentialId], references: [id], onDelete: Cascade)
  template     MessageTemplate? @relation(fields: [templateId], references: [id])
  @@index([businessId, createdAt(sort: Desc)])
  @@map("bulk_send_jobs")
}

model WebhookSubscription {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  accountAlerts                Boolean @default(false)
  accountReviewUpdate          Boolean @default(false)
  accountUpdate                Boolean @default(false)
  businessCapacityUpdate       Boolean @default(false)
  messageTemplateQualityUpdate Boolean @default(false)
  messageTemplateStatusUpdate  Boolean @default(false)
  messages                     Boolean @default(true)
  phoneNumberNameUpdate        Boolean @default(false)
  phoneNumberQualityUpdate     Boolean @default(false)
  security                     Boolean @default(false)
  templateCategoryUpdate       Boolean @default(false)
  subscribedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([businessId])
  @@map("webhook_subscriptions")
}

model AccountEvent {
  id         String            @id @default(cuid())
  businessId String
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  field      WebhookEventField
  payload    Json
  processed  Boolean           @default(false)
  createdAt  DateTime          @default(now())
  @@index([businessId, field, createdAt(sort: Desc)])
  @@map("account_events")
}

enum WebhookEventField {
  ACCOUNT_ALERTS ACCOUNT_REVIEW_UPDATE ACCOUNT_UPDATE BUSINESS_CAPACITY_UPDATE
  MESSAGE_TEMPLATE_QUALITY_UPDATE MESSAGE_TEMPLATE_STATUS_UPDATE MESSAGES
  PHONE_NUMBER_NAME_UPDATE PHONE_NUMBER_QUALITY_UPDATE SECURITY TEMPLATE_CATEGORY_UPDATE
}
