# ─────────────────────────────────────────────
# SHARED — copy this to each app's .env.local
# ─────────────────────────────────────────────

# PostgreSQL (Supabase)
# Get this from: supabase.com → Project Settings → Database → Connection String (URI)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Redis (Upstash)
# Get this from: console.upstash.com → Redis → REST API
REDIS_URL="rediss://:[YOUR-TOKEN]@[YOUR-ENDPOINT].upstash.io:6379"

# ─────────────────────────────────────────────
# apps/api
# ─────────────────────────────────────────────
API_PORT=4000
# Strong random secret: run `openssl rand -hex 32`
JWT_SECRET="replace_with_32_char_random_secret"
# AES-256 key for encrypting WA credentials: run `openssl rand -hex 32`
ENCRYPTION_KEY="replace_with_32_char_random_secret"
# OxaPay merchant key for crypto payments
OXAPAY_MERCHANT_KEY="3RDHFD-9WWVA6-7KWP4B-AYGMHB"
# Your API public URL (used for OxaPay callback)
API_URL="https://api.whatsapi.buzz"
# Admin/Manager seed passwords (optional — auto-generated if not set)
ADMIN_PASSWORD=""
MANAGER_PASSWORD=""

# ─────────────────────────────────────────────
# apps/webhook
# ─────────────────────────────────────────────
WEBHOOK_PORT=4001
# A random string you invent — must match what you register with Meta
WEBHOOK_VERIFY_TOKEN="replace_with_your_verify_token"

# ─────────────────────────────────────────────
# apps/web (Next.js)
# ─────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Strong random secret: run `openssl rand -hex 32`
NEXTAUTH_SECRET="replace_with_32_char_random_secret"
# Internal API base URL
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Internal Webhook service URL
NEXT_PUBLIC_WEBHOOK_URL="http://localhost:4001"
